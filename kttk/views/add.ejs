<!DOCTYPE html>
<html>
<head>
  <title>Add</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<h2>Add</h2>

<form action="/create" method="POST" enctype="multipart/form-data">

  <label>Event Name:</label><br>
  <input type="text" name="eventName" required><br><br>

  <label>Holder Name:</label><br>
  <input type="text" name="holderName" required><br><br>

  <label>Category:</label><br>
  <select name="category" required>
    <option value="Standard">Standard</option>
    <option value="VIP">VIP</option>
    <option value="VVIP">VVIP</option>
  </select><br><br>

  <label>Quantity:</label><br>
  <input type="number" name="quantity" min="1" required><br><br>

  <label>Price per Ticket:</label><br>
  <input type="number" name="pricePerTicket" min="1" required><br><br>

  <label>Event Date:</label><br>
  <input type="date" name="eventDate" required><br><br>

  <label>Status:</label><br>
  <select name="status">
    <option value="Upcoming">Upcoming</option>
    <option value="Sold">Sold</option>
    <option value="Cancelled">Cancelled</option>
  </select><br><br>

  <label>Image:</label><br>
  <input type="file" name="image" accept="image/*"><br><br>

  <button type="submit">Create</button>
</form>

<br>
<a href="/">⬅ Back</a>

</body>
</html>